# Copy this file to backend/.env for local development. Never commit backend/.env.
NODE_ENV=development
PORT=4000

# Use a least-privilege PostgreSQL application user. This is an example only.
DATABASE_URL=postgresql://sigma_hrm_app:replace-with-a-local-password@localhost:5432/sigma_hrm
DATABASE_SSL=false

# Comma-separated browser origins. Leave blank until the frontend is migrated.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Reserved for the later authentication migration; no authentication is implemented yet.
AUTH_TOKEN_ISSUER=sigma-hrm-api
AUTH_TOKEN_AUDIENCE=sigma-hrm-web

# Signing key for access/refresh tokens. Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=replace-with-a-generated-secret-at-least-32-characters
